# 复制为 .env，填写本机值；勿提交或分享。
YOVOICE_URL=http://127.0.0.1:3081
YOVOICE_API_TOKEN=REPLACE_WITH_64_HEX_RANDOM_TOKEN
YOVOICE_CLI=/absolute/path/to/yovoice
YOVOICE_DATA_DIR=/absolute/path/to/yovoice-data
GLM_CODING_PLAN_API_KEY=REPLACE_WITH_GLM_CODING_PLAN_API_KEY
DSH_LIVESTREAM_LOCAL_REHEARSAL=1
DSH_LIVESTREAM_TTS_BACKEND=yovoice
DSH_LIVESTREAM_YOVOICE_MODEL=voxcpm2-q8
DSH_LIVESTREAM_YOVOICE_VOICE="年轻温暖的中文女声，自然亲切，像和朋友聊天，咬字清楚，语气轻松活泼"

# 可选：可信 Nominatim 兼容服务的 HTTPS /search 地址；默认使用公共 Nominatim。
# DSH_LIVESTREAM_WEATHER_GEOCODER_URL=https://your-nominatim-host/search

# 可选：公屏发送受信部署引用；所有路径为维护者准备的规范绝对路径。
# 缺任一项时发送不可用，材料内容不写入普通设置或本示例。
# DSH_PUBLIC_CHAT_BUILD_DEPLOYMENT_FILE=/absolute/path/to/protected-build-deployment.json
# DSH_PUBLIC_CHAT_DEPLOYMENT_FILE=/absolute/path/to/protected-sender-deployment.json
# DSH_PUBLIC_CHAT_BROWSER_EXECUTABLE=/absolute/path/to/chrome
# DSH_PUBLIC_CHAT_HELPER_MANIFEST=/absolute/path/to/protected-helper-manifest.json
# DSH_PUBLIC_CHAT_HELPER_MANIFEST_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
# DSH_PUBLIC_CHAT_HELPER_SOURCE_DIRECTORY=/absolute/path/to/publicChat/httpHelper
# DSH_PUBLIC_CHAT_MATERIAL_FILE=/absolute/path/to/protected-material.json
# DSH_PUBLIC_CHAT_HELPER_DATA_DIR=/absolute/path/to/private-helper-data
