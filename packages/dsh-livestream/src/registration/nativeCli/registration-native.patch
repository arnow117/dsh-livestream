+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestRegistrationStrictInput(t *testing.T) {
+	for _, input := range []string{
+		`{"action":"record_get","base":"other"}`,
+		`{"action":"record_get","action":"record_patch"}`,
+		`{"action":"record_patch","patch":{"field":"\ud800"}}`,
+		`{"action":"record_patch","patch":{"field":"\udc00"}}`,
+		`{"action":"record_get"} {}`,
+	} {
+		var decoded request
+		if decodeJSON([]byte(input), &decoded) == nil {
+			t.Errorf("accepted malformed input %s", input)
+		}
+	}
+	var decoded request
+	if err := decodeJSON([]byte(`{"action":"record_patch","patch":{"field":"\ud83d\ude00"}}`), &decoded); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRegistrationBindingRejectsSymlinkAndWrongMode(t *testing.T) {
+	dir := t.TempDir()
+	old, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(dir); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Chdir(old)
+	content := []byte(`{"action":"record_get","profile":"p","brand":"feishu","base":"b","table":"t","record":"r","fields":["f"],"writableFields":[]}`)
+	if err := os.WriteFile("registration-binding.json", content, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := loadBinding(); err == nil {
+		t.Fatal("accepted writable binding")
+	}
+	if err := os.Chmod("registration-binding.json", 0400); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := loadBinding(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename("registration-binding.json", "original.json"); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(dir, "original.json"), "registration-binding.json"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := loadBinding(); err == nil {
+		t.Fatal("accepted symlink binding")
+	}
+}
