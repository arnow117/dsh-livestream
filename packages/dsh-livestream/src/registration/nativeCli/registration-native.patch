+func TestRegistrationRefreshUsesFixedAccountsEndpoint(t *testing.T) {
+	operation := &registrationOperation{ctx: context.Background(), host: "open.feishu.cn", method: "GET", path: "/open-apis/test"}
+	accepted, _ := http.NewRequest("POST", "https://accounts.feishu.cn/oauth/v3/token", nil)
+	if !operation.allow(accepted) {
