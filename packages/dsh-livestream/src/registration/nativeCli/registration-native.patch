+//go:build registration_fixture
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/larksuite/cli/errs"
+)
+
+func fixtureEnvironment() map[string]string {
+	values := map[string]string{}
+	for _, name := range []string{"REGISTRATION_FIXTURE_ADDR", "REGISTRATION_FIXTURE_CA", "REGISTRATION_FIXTURE_STORE"} {
+		values[name] = os.Getenv(name)
+	}
+	return values
+}
+
+func reportFailure(err error) {
+	for depth := 0; err != nil && depth < 8; depth++ {
+		if err.Error() == "fixture storage unavailable" {
+			fmt.Fprintln(os.Stderr, "fixture error type=fixture_storage_unavailable")
+		}
+		if errors.Is(err, os.ErrPermission) {
+			fmt.Fprintln(os.Stderr, "fixture error type=permission")
+		}
+		if problem, ok := errs.ProblemOf(err); ok {
+			fmt.Fprintf(os.Stderr, "fixture error type=%T category=%s subtype=%s\n", err, problem.Category, problem.Subtype)
+		} else {
+			fmt.Fprintf(os.Stderr, "fixture error type=%T\n", err)
+		}
+		err = errors.Unwrap(err)
+	}
+}
