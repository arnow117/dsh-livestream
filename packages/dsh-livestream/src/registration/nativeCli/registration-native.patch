+package transport
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptrace"
+	"net/textproto"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/larksuite/cli/errs"
+)
+
+const registrationJSONLimit = 1 << 20
+const registrationWireLimit = 8 << 20
+const registrationDialLimit = 12
+
+var errRegistrationLimit = errs.NewSecurityPolicyError(errs.SubtypeAccessDenied, "registration transport policy rejected request")
+
+type registrationOperation struct {
+	ctx           context.Context
+	host          string
+	method        string
+	path          string
+	query         string
+	resourceCount atomic.Int32
+	authCount     atomic.Int32
+}
+
+var registrationCurrent *registrationOperation
+
+// ConfigureRegistrationOperation is called once by the private executable before Build.
+func ConfigureRegistrationOperation(ctx context.Context, brand, method, path, query string) error {
+	if registrationCurrent != nil || ctx == nil || (brand != "feishu" && brand != "lark") ||
+		(method != http.MethodGet && method != http.MethodPost && method != http.MethodPut) ||
+		!strings.HasPrefix(path, "/open-apis/") || strings.ContainsAny(path, "?#") {
+		return errRegistrationLimit
+	}
+	host := "open.feishu.cn"
+	if brand == "lark" {
+		host = "open.larksuite.com"
+	}
+	if query != "" && (method != http.MethodGet || path != "/open-apis/drive/v1/medias/batch_get_tmp_download_url") {
+		return errRegistrationLimit
+	}
+	registrationCurrent = &registrationOperation{ctx: ctx, host: host, method: method, path: path, query: query}
+	return nil
+}
+
+func (p *registrationOperation) allow(req *http.Request) bool {
+	if p == nil || req == nil || req.URL == nil || req.URL.Scheme != "https" || req.URL.User != nil || req.URL.Fragment != "" {
+		return false
+	}
+	accounts := "accounts.feishu.cn"
+	if p.host == "open.larksuite.com" {
+		accounts = "accounts.larksuite.com"
+	}
+	if req.Method == http.MethodPost && req.URL.Host == accounts && req.URL.Path == "/accounts/status/heartbeat" && req.URL.RawQuery == "" {
+		return req.Header.Get("Authorization") == "" && p.authCount.Add(1) <= 8
+	}
+	if req.Method == http.MethodPost && req.URL.Host == accounts && req.URL.Path == "/oauth/v3/token" && req.URL.RawQuery == "" {
+		return p.authCount.Add(1) <= 8
+	}
+	return req.Context().Err() == nil && p.ctx.Err() == nil && req.Method == p.method && req.URL.Host == p.host && req.URL.Path == p.path && req.URL.RawQuery == p.query && p.resourceCount.Add(1) == 1
+}
+
+// registrationBudgetConn counts encrypted socket input, including TLS records.
+type registrationBudgetConn struct {
+	net.Conn
+	remaining int64
+}
+
+func (c *registrationBudgetConn) Read(p []byte) (int, error) {
+	if c.remaining <= 0 {
+		registrationFixtureBudgetExhausted(registrationWireLimit)
+		_ = c.Conn.Close()
+		return 0, errRegistrationLimit
+	}
+	if int64(len(p)) > c.remaining {
+		p = p[:int(c.remaining)]
+	}
+	n, err := c.Conn.Read(p)
+	c.remaining -= int64(n)
+	return n, err
+}
+
+type registrationDialBudget struct{ attempts atomic.Int32 }
+
+func (b *registrationDialBudget) dial(ctx context.Context, network, address string) (net.Conn, error) {
+	if b.attempts.Add(1) > registrationDialLimit || network != "tcp" {
+		return nil, errRegistrationLimit
+	}
+	host, port, err := net.SplitHostPort(address)
+	if err != nil || port != "443" || (host != "open.feishu.cn" && host != "open.larksuite.com" && host != "accounts.feishu.cn" && host != "accounts.larksuite.com") {
+		return nil, errRegistrationLimit
+	}
+	if conn, used, err := registrationFixtureDial(ctx); used {
+		if err != nil {
+			return nil, err
+		}
+		return &registrationBudgetConn{Conn: conn, remaining: registrationWireLimit}, nil
+	}
+	addresses, err := net.DefaultResolver.LookupIPAddr(ctx, host)
+	if err != nil || len(addresses) == 0 || len(addresses) > 16 {
+		return nil, errRegistrationLimit
+	}
+	first := addresses[0]
+	ip := first.IP.String()
+	if first.Zone != "" {
+		ip += "%" + first.Zone
+	}
+	dialer := net.Dialer{Timeout: 10 * time.Second, FallbackDelay: -1}
+	conn, err := dialer.DialContext(ctx, "tcp", net.JoinHostPort(ip, port))
+	if err != nil {
+		return nil, err
+	}
+	return &registrationBudgetConn{Conn: conn, remaining: registrationWireLimit}, nil
+}
+
+// registrationLeaf remains present around every structurally rebuilt transport.
+type registrationLeaf struct {
+	base   *http.Transport
+	budget *registrationDialBudget
+}
+
+func newRegistrationLeaf(budget *registrationDialBudget) *registrationLeaf {
+	t := &http.Transport{
+		Proxy:                  nil,
+		DialContext:            budget.dial,
+		DisableCompression:     true,
+		DisableKeepAlives:      true,
+		ForceAttemptHTTP2:      false,
+		TLSNextProto:           map[string]func(string, *tls.Conn) http.RoundTripper{},
+		TLSHandshakeTimeout:    10 * time.Second,
+		MaxResponseHeaderBytes: 16 << 10,
+		TLSClientConfig:        registrationFixtureTLS(),
+	}
+	return &registrationLeaf{base: t, budget: budget}
+}
+
+func (t *registrationLeaf) BaseRoundTripper() http.RoundTripper { return t.base }
+
+func (t *registrationLeaf) WithBaseRoundTripper(base http.RoundTripper) http.RoundTripper {
+	if _, ok := base.(*http.Transport); !ok {
+		return registrationDeny{}
+	}
+	return newRegistrationLeaf(t.budget)
+}
+
+type registrationDeny struct{}
+
+func (registrationDeny) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, errRegistrationLimit
+}
+
+func (t *registrationLeaf) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req == nil || req.Header.Get("Accept-Encoding") != "identity" || !registrationCurrent.allow(req) {
+		return nil, errRegistrationLimit
+	}
+	if req.Body != nil && req.Body != http.NoBody {
+		body, err := io.ReadAll(io.LimitReader(req.Body, registrationJSONLimit+1))
+		_ = req.Body.Close()
+		if err != nil || len(body) > registrationJSONLimit || (req.ContentLength >= 0 && req.ContentLength != int64(len(body))) {
+			return nil, errRegistrationLimit
+		}
+		req = req.Clone(req.Context())
+		req.Body = io.NopCloser(bytes.NewReader(body))
+		req.ContentLength = int64(len(body))
+		req.GetBody = nil
+	}
+	response, err := t.base.RoundTrip(req)
+	if err != nil || response == nil || response.Body == nil {
+		if response != nil && response.Body != nil {
+			_ = response.Body.Close()
+		}
+		return nil, errRegistrationLimit
+	}
+	defer response.Body.Close()
+	encoding := response.Header.Get("Content-Encoding")
+	if response.StatusCode == 101 || (response.StatusCode >= 300 && response.StatusCode < 400) ||
+		(encoding != "" && !strings.EqualFold(encoding, "identity")) || response.ContentLength > registrationJSONLimit {
+		return nil, errRegistrationLimit
+	}
+	body, err := io.ReadAll(io.LimitReader(response.Body, registrationJSONLimit+1))
+	if err != nil || len(body) > registrationJSONLimit || (response.ContentLength >= 0 && int64(len(body)) != response.ContentLength) {
+		return nil, errRegistrationLimit
+	}
+	response.Body = io.NopCloser(bytes.NewReader(body))
+	response.ContentLength = int64(len(body))
+	response.Header.Set("Content-Length", strconv.Itoa(len(body)))
+	return response, nil
+}
+
+// RegistrationRequestGuard must be outside signing so identity is signed as sent.
+type RegistrationRequestGuard struct{ Base http.RoundTripper }
+
+func (t *RegistrationRequestGuard) BaseRoundTripper() http.RoundTripper { return t.Base }
+func (t *RegistrationRequestGuard) WithBaseRoundTripper(base http.RoundTripper) http.RoundTripper {
+	return &RegistrationRequestGuard{Base: base}
+}
+func (t *RegistrationRequestGuard) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req == nil || t.Base == nil {
+		return nil, errRegistrationLimit
+	}
+	old := httptrace.ContextClientTrace(req.Context())
+	if old != nil && old.Got1xxResponse != nil {
+		return nil, errRegistrationLimit
+	}
+	count := 0
+	trace := &httptrace.ClientTrace{Got1xxResponse: func(code int, _ textproto.MIMEHeader) error {
+		count++
+		if code == 101 || count > 4 {
+			return errRegistrationLimit
+		}
+		return nil
+	}}
+	request := req.Clone(httptrace.WithClientTrace(req.Context(), trace))
+	request.Header = req.Header.Clone()
+	request.Header.Set("Accept-Encoding", "identity")
+	if request.Body != nil && request.Body != http.NoBody {
+		body, err := io.ReadAll(io.LimitReader(request.Body, registrationJSONLimit+1))
+		_ = request.Body.Close()
+		if err != nil || len(body) > registrationJSONLimit || (request.ContentLength >= 0 && request.ContentLength != int64(len(body))) {
+			return nil, errRegistrationLimit
+		}
+		request.Body = io.NopCloser(bytes.NewReader(body))
+		request.ContentLength = int64(len(body))
+		request.GetBody = func() (io.ReadCloser, error) { return io.NopCloser(bytes.NewReader(body)), nil }
+	}
+	return t.Base.RoundTrip(request)
+}
