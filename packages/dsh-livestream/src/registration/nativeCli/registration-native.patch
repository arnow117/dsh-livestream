+//go:build registration_fixture
+
+package main
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/base64"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/larksuite/cli/internal/auth"
+	"github.com/larksuite/cli/internal/dpop"
+	"github.com/larksuite/cli/internal/keychain"
+	"github.com/larksuite/cli/internal/keysigner"
+)
+
+func run() error {
+	root := keychain.StorageDir(keychain.LarkCliService)
+	if root == "" {
+		return fmt.Errorf("fixture storage unavailable")
+	}
+	secret := make([]byte, 32)
+	if _, err := rand.Read(secret); err != nil {
+		return err
+	}
+	defer clear(secret)
+	if err := keychain.Set(keychain.LarkCliService, "dpop:software:unlock:v1", base64.StdEncoding.EncodeToString(secret)); err != nil {
+		return err
+	}
+	signer, err := keysigner.NewSoftwareSigner(filepath.Join(root, "keysigner", keysigner.SoftwareSignerName), func(context.Context) ([]byte, error) { return append([]byte(nil), secret...), nil })
+	if err != nil {
+		return err
+	}
+	store := dpop.NewKeyStoreWithSigner(nil, signer)
+	key, err := store.EnsureContext(context.Background(), "fixture-key")
+	if err != nil {
+		return err
+	}
+	if err := store.Save(key); err != nil {
+		return err
+	}
+	thumbprint, err := key.Thumbprint()
+	if err != nil {
+		return err
+	}
+	if err := keychain.Set(keychain.LarkCliService, "appsecret:app1", "synthetic-app-secret"); err != nil {
+		return err
+	}
+	now := time.Now()
+	return auth.SetStoredToken(&auth.StoredUAToken{AppId: "app1", UserOpenId: "user1", AccessToken: "synthetic-bound-token", RefreshToken: "synthetic-bound-refresh", ExpiresAt: now.Add(time.Hour).UnixMilli(), RefreshExpiresAt: now.Add(2 * time.Hour).UnixMilli(), Scope: "base:record:read base:record:update base:record:create", GrantedAt: now.UnixMilli(), TokenType: auth.StoredTokenTypeDPoP, DPoPKeyID: key.ID(), DPoPJKT: thumbprint, DPoPKeySecurityLevel: string(key.SecurityLevel())})
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, "fixture setup failed")
+		os.Exit(1)
+	}
+}
