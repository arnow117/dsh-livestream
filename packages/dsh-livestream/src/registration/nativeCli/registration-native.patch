+func TestRegistrationLimiterSyntheticTLS(t *testing.T) {
+	for _, size := range []int{16, registrationJSONLimit + 1} {
+		server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, strings.Repeat("x", size))
+		}))
+		registrationCurrent = &registrationOperation{ctx: context.Background(), host: "open.feishu.cn", method: "GET", path: "/open-apis/test"}
+		leaf := newRegistrationLeaf(&registrationDialBudget{})
+		leaf.base.TLSClientConfig = &tls.Config{RootCAs: server.Client().Transport.(*http.Transport).TLSClientConfig.RootCAs, ServerName: "example.com"}
+		leaf.base.DialContext = func(ctx context.Context, _, _ string) (net.Conn, error) {
+			var d net.Dialer
+			return d.DialContext(ctx, "tcp", server.Listener.Addr().String())
+		}
+		req, _ := http.NewRequest("GET", "https://open.feishu.cn/open-apis/test", nil)
+		response, err := (&RegistrationRequestGuard{Base: leaf}).RoundTrip(req)
+		if size <= registrationJSONLimit {
+			if err != nil {
+				t.Fatal(err)
+			}
+			body, err := io.ReadAll(response.Body)
+			if err != nil || len(body) != size {
+				t.Fatal("small response mismatch")
+			}
+			_ = response.Body.Close()
+		} else if err == nil || response != nil {
+			t.Fatal("oversized response reached caller")
+		}
+		server.Close()
+	}
+}
+
+func TestRegistrationRejectsOld1xxHook(t *testing.T) {
+	called := false
+	base := registrationTestRoundTripper(func(*http.Request) (*http.Response, error) { called = true; return nil, nil })
+	req, _ := http.NewRequest("GET", "https://open.feishu.cn/open-apis/test", nil)
+	ctx := httptrace.WithClientTrace(req.Context(), &httptrace.ClientTrace{Got1xxResponse: func(int, textproto.MIMEHeader) error { return nil }})
+	if _, err := (&RegistrationRequestGuard{Base: base}).RoundTrip(req.WithContext(ctx)); err == nil || called {
+		t.Fatal("old 1xx hook not rejected")
+	}
+}
+
+type registrationTestRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f registrationTestRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestRegistrationLocalPolicyCategorySurvivesURLWrapping(t *testing.T) {
+	wrapped := &url.Error{Op: "Post", URL: "https://example.invalid", Err: errRegistrationLimit}
+	problem, ok := errs.ProblemOf(wrapped)
+	if !ok || problem.Category != errs.CategoryPolicy || errors.Is(wrapped, context.Canceled) {
+		t.Fatal("local rejection lost policy category")
+	}
+}
+
+func TestRegistrationSocketReadBudget(t *testing.T) {
+	reader, writer := net.Pipe()
+	defer writer.Close()
+	conn := &registrationBudgetConn{Conn: reader, remaining: registrationWireLimit}
+	defer conn.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _ = writer.Write(bytes.Repeat([]byte{'x'}, registrationWireLimit+1))
+	}()
+	bytesRead, err := io.Copy(io.Discard, conn)
+	if bytesRead != registrationWireLimit || !errors.Is(err, errRegistrationLimit) {
+		t.Fatalf("budget mismatch: bytes=%d, err=%v", bytesRead, err)
+	}
+	<-done
+}
