+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"os/signal"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"syscall"
+	"unicode/utf8"
+
+	"github.com/larksuite/cli/cmd"
+	"github.com/larksuite/cli/internal/cmdutil"
+	"github.com/larksuite/cli/internal/core"
+	"github.com/larksuite/cli/internal/transport"
+)
+
+const maxInput = 1 << 20
+
+var identifier = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)
+
+type request struct {
+	Action string          `json:"action"`
+	Patch  json.RawMessage `json:"patch"`
+}
+
+// binding is written only by the trusted host into the invocation directory.
+type binding struct {
+	Action          string   `json:"action"`
+	Profile         string   `json:"profile"`
+	Brand           string   `json:"brand"`
+	Base            string   `json:"base"`
+	Table           string   `json:"table"`
+	Record          string   `json:"record"`
+	Fields          []string `json:"fields"`
+	WritableFields  []string `json:"writableFields"`
+	NumericFields   []string `json:"numericFields"`
+	PhotoField      string   `json:"photoField"`
+	AttachmentToken string   `json:"attachmentToken,omitempty"`
+	AttachmentExtra string   `json:"attachmentExtra,omitempty"`
+}
+
+func hex4(data []byte) (uint16, bool) {
+	if len(data) < 4 {
+		return 0, false
+	}
+	var value uint16
+	for _, char := range data[:4] {
+		value <<= 4
+		switch {
+		case char >= '0' && char <= '9':
+			value += uint16(char - '0')
+		case char >= 'a' && char <= 'f':
+			value += uint16(char - 'a' + 10)
+		case char >= 'A' && char <= 'F':
+			value += uint16(char - 'A' + 10)
+		default:
+			return 0, false
+		}
+	}
+	return value, true
+}
+
+func validUTF16Escapes(data []byte) bool {
+	inString := false
+	for i := 0; i < len(data); i++ {
+		if !inString {
+			if data[i] == '"' {
+				inString = true
+			}
+			continue
+		}
+		if data[i] == '"' {
+			inString = false
+			continue
+		}
+		if data[i] != '\\' {
+			continue
+		}
+		i++
+		if i >= len(data) {
+			return false
+		}
+		if data[i] != 'u' {
+			continue
+		}
+		value, ok := hex4(data[i+1:])
+		if !ok {
+			return false
+		}
+		i += 4
+		if value >= 0xdc00 && value <= 0xdfff {
+			return false
+		}
+		if value >= 0xd800 && value <= 0xdbff {
+			if i+6 >= len(data) || data[i+1] != '\\' || data[i+2] != 'u' {
+				return false
+			}
+			low, ok := hex4(data[i+3:])
+			if !ok || low < 0xdc00 || low > 0xdfff {
+				return false
+			}
+			i += 6
+		}
+	}
+	return !inString
+}
+
+func validateJSONValue(decoder *json.Decoder, depth int) error {
+	if depth > 32 {
+		return errors.New("invalid input")
+	}
+	token, err := decoder.Token()
+	if err != nil {
+		return err
+	}
+	delim, ok := token.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := map[string]bool{}
+		for decoder.More() {
+			key, err := decoder.Token()
+			if err != nil {
+				return err
+			}
+			name, ok := key.(string)
+			if !ok || seen[name] {
+				return errors.New("invalid input")
+			}
+			seen[name] = true
+			if err := validateJSONValue(decoder, depth+1); err != nil {
+				return err
+			}
+		}
+	case '[':
+		for decoder.More() {
+			if err := validateJSONValue(decoder, depth+1); err != nil {
+				return err
+			}
+		}
+	default:
+		return errors.New("invalid input")
+	}
+	_, err = decoder.Token()
+	return err
+}
+
+func decodeJSON(data []byte, result any) error {
+	if len(data) > maxInput || !utf8.Valid(data) || !validUTF16Escapes(data) {
+		return errors.New("invalid input")
+	}
+	check := json.NewDecoder(bytes.NewReader(data))
+	if err := validateJSONValue(check, 0); err != nil {
+		return errors.New("invalid input")
+	}
+	if _, err := check.Token(); err != io.EOF {
+		return errors.New("invalid input")
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(result); err != nil {
+		return errors.New("invalid input")
+	}
+	return nil
+}
+
+func decodeInput() (request, error) {
+	var result request
+	data, err := io.ReadAll(io.LimitReader(os.Stdin, maxInput+1))
+	if err != nil || len(data) > maxInput {
+		return result, errors.New("invalid input")
+	}
+	err = decodeJSON(data, &result)
+	return result, err
+}
+
+func loadBinding() (binding, error) {
+	var result binding
+	fd, err := syscall.Open("registration-binding.json", syscall.O_RDONLY|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return result, errors.New("binding unavailable")
+	}
+	file := os.NewFile(uintptr(fd), "registration-binding.json")
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0400 || info.Size() > 16384 {
+		return result, errors.New("binding unavailable")
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != uint32(os.Getuid()) || stat.Nlink != 1 {
+		return result, errors.New("binding unavailable")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 16385))
+	if err != nil || len(data) > 16384 {
+		return result, errors.New("binding unavailable")
+	}
+	err = decodeJSON(data, &result)
+	return result, err
+}
+
+func run() int {
+	if len(os.Args) == 2 && os.Args[1] == "--version" {
+		fmt.Fprintln(os.Stdout, "registration-native 1.0.99-derived")
+		return 0
+	}
+	if len(os.Args) != 1 {
+		fmt.Fprintln(os.Stderr, "invalid invocation")
+		return 2
+	}
+	keep := map[string]string{}
+	for _, name := range []string{"HOME", "USER", "PATH", "LANG", "TMPDIR", "LARKSUITE_CLI_CONFIG_DIR"} {
+		if value, ok := os.LookupEnv(name); ok {
+			keep[name] = value
+		}
+	}
+	for name, value := range fixtureEnvironment() {
+		keep[name] = value
+	}
+	if keep["LARKSUITE_CLI_CONFIG_DIR"] == "" {
+		return 2
+	}
+	os.Clearenv()
+	for name, value := range keep {
+		_ = os.Setenv(name, value)
+	}
+	req, err := decodeInput()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "invalid invocation")
+		return 2
+	}
+	bound, err := loadBinding()
+	if err != nil || req.Action != bound.Action || !identifier.MatchString(bound.Profile) || (bound.Brand != "feishu" && bound.Brand != "lark") {
+		fmt.Fprintln(os.Stderr, "invalid invocation")
+		return 2
+	}
+	if !identifier.MatchString(bound.Base) || !identifier.MatchString(bound.Table) || !identifier.MatchString(bound.Record) {
+		fmt.Fprintln(os.Stderr, "invalid invocation")
+		return 2
+	}
+	allowed := map[string]bool{}
+	for _, field := range bound.Fields {
+		if !identifier.MatchString(field) || allowed[field] {
+			fmt.Fprintln(os.Stderr, "invalid invocation")
+			return 2
+		}
+		allowed[field] = true
+	}
+	if len(bound.Fields) == 0 || len(bound.Fields) > 32 {
+		fmt.Fprintln(os.Stderr, "invalid invocation")
+		return 2
+	}
+	writable := map[string]bool{}
+	for _, field := range bound.WritableFields {
+		if !allowed[field] || writable[field] {
+			return 2
+		}
+		writable[field] = true
+	}
+	numeric := map[string]bool{}
+	for _, field := range bound.NumericFields {
+		if !writable[field] || numeric[field] {
+			return 2
+		}
+		numeric[field] = true
+	}
+	if bound.PhotoField != "" && (!writable[bound.PhotoField] || numeric[bound.PhotoField]) {
+		return 2
+	}
+	if req.Action != "attachment_url" && (bound.AttachmentToken != "" || bound.AttachmentExtra != "") {
+		return 2
+	}
+	common := []string{"--format", "json", "--profile", bound.Profile, "--as", "user"}
+	basePath := "/open-apis/base/v3/bases/" + bound.Base + "/tables/" + bound.Table
+	method, endpoint, query := "", "", ""
+	var args []string
+	var payload []byte
+	switch req.Action {
+	case "user_info":
+		if len(req.Patch) != 0 {
+			return 2
+		}
+		method, endpoint = "GET", "/open-apis/authen/v1/user_info"
+		args = append([]string{"api", method, endpoint}, common...)
+	case "record_get":
+		if len(req.Patch) != 0 {
+			return 2
+		}
+		method, endpoint = "POST", basePath+"/records/batch_get"
+		args = []string{"base", "+record-get", "--base-token", bound.Base, "--table-id", bound.Table, "--record-id", bound.Record}
+		for _, field := range bound.Fields {
+			args = append(args, "--field-id", field)
+		}
+		args = append(args, common...)
+	case "attachment_metadata":
+		if len(req.Patch) != 0 {
+			return 2
+		}
+		method, endpoint = "POST", basePath+"/get_attachments"
+		payload, _ = json.Marshal(map[string][]string{"record_id_list": {bound.Record}})
+		args = []string{"api", method, endpoint, "--data", "@registration-payload.json"}
+		args = append(args, common...)
+	case "attachment_url":
+		if len(req.Patch) != 0 || !identifier.MatchString(bound.AttachmentToken) || len(bound.AttachmentExtra) > 8192 || strings.IndexFunc(bound.AttachmentExtra, func(r rune) bool { return r < 0x20 || r == 0x7f }) >= 0 {
+			return 2
+		}
+		method, endpoint = "GET", "/open-apis/drive/v1/medias/batch_get_tmp_download_url"
+		parameters := map[string]interface{}{"file_tokens": []string{bound.AttachmentToken}}
+		values := url.Values{"file_tokens": []string{bound.AttachmentToken}}
+		if bound.AttachmentExtra != "" {
+			parameters["extra"] = bound.AttachmentExtra
+			values.Set("extra", bound.AttachmentExtra)
+		}
+		query = values.Encode()
+		encoded, err := json.Marshal(parameters)
+		if err != nil {
+			return 2
+		}
+		args = []string{"api", method, endpoint, "--params", string(encoded)}
+		args = append(args, common...)
+	case "record_patch":
+		var body struct {
+			Fields map[string]json.RawMessage `json:"fields"`
+		}
+		if len(req.Patch) == 0 || decodeJSON(req.Patch, &body) != nil || len(body.Fields) == 0 || len(writable) == 0 {
+			return 2
+		}
+		for key, raw := range body.Fields {
+			if !writable[key] {
+				return 2
+			}
+			if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+				continue
+			}
+			if key == bound.PhotoField {
+				var attachments []struct {
+					FileToken string `json:"file_token"`
+				}
+				if decodeJSON(raw, &attachments) != nil || len(attachments) != 1 || !identifier.MatchString(attachments[0].FileToken) {
+					return 2
+				}
+			} else if numeric[key] {
+				value, err := strconv.ParseInt(string(raw), 10, 64)
+				if err != nil || value <= 0 || value > 9007199254740991 {
+					return 2
+				}
+			} else {
+				var value string
+				if json.Unmarshal(raw, &value) != nil {
+					return 2
+				}
+			}
+		}
+		method = "PUT"
+		endpoint = "/open-apis/bitable/v1/apps/" + bound.Base + "/tables/" + bound.Table + "/records/" + bound.Record
+		payload = req.Patch
+		args = []string{"api", method, endpoint, "--data", "@registration-payload.json"}
+		args = append(args, common...)
+	default:
+		return 2
+	}
+	if len(payload) != 0 {
+		file, err := os.OpenFile(filepath.Join(".", "registration-payload.json"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+		if err != nil {
+			return 2
+		}
+		_, writeErr := file.Write(payload)
+		closeErr := file.Close()
+		defer os.Remove("registration-payload.json")
+		if writeErr != nil || closeErr != nil {
+			return 2
+		}
+	}
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt)
+	defer cancel()
+	if err := transport.ConfigureRegistrationOperation(ctx, bound.Brand, method, endpoint, query); err != nil {
+		return 2
+	}
+	http.DefaultTransport = &transport.RegistrationRequestGuard{Base: transport.Shared()}
+	http.DefaultClient.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	inv := cmdutil.InvocationContext{Profile: bound.Profile, ProfileSource: core.ProfileFromFlag}
+	root := cmd.Build(ctx, inv, cmd.WithoutPlugins(), cmd.WithInvocationArgs(args))
+	if err := root.ExecuteContext(ctx); err != nil {
+		reportFailure(err)
+		return 1
+	}
+	return 0
+}
+
+func main() { os.Exit(run()) }
