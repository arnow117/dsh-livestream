+func TestRegistrationAttachmentQueryExact(t *testing.T) {
+	path := "/open-apis/drive/v1/medias/batch_get_tmp_download_url"
+	query := url.Values{"file_tokens": {"token1"}, "extra": {"{\"source\":\"row\"}"}}.Encode()
