{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-public-chat-http-v1",
  "title": "Private helper request frame and operation payloads",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "seq",
    "kind",
    "operationId",
    "payloadHash",
    "expectedHelperNonce",
    "authContextId",
    "authContextRevision",
    "materialDigest",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "dsh-public-chat-http-v1"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": [
        "hello",
        "profile",
        "bindGrant",
        "revoke",
        "query",
        "send",
        "reconcileMessage"
      ]
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payloadHash": {
      "type": "string",
      "maxLength": 64
    },
    "expectedHelperNonce": {
      "type": "string",
      "maxLength": 128
    },
    "authContextId": {
      "type": "string",
      "maxLength": 128
    },
    "authContextRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "materialDigest": {
      "type": "string",
      "maxLength": 64
    },
    "payload": {
      "type": "object"
    }
  },
  "description": "Bounded UTF-8 JSON after a four-byte big-endian length; material is read only from the inherited descriptor. Automatic events must be verified against the original raw source by the trusted sender before this private request.",
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "senderProcessNonce",
        "authorizationId",
        "captureId",
        "accountRecordId",
        "helperProcessNonce",
        "authContextId",
        "rawSourceSessionId",
        "rawBrowserContextId",
        "liveEpoch",
        "senderConnectionGeneration",
        "qualificationRevision",
        "identityEpoch",
        "authContextRevision",
        "rawSourceConnectionGeneration",
        "inputConnectionGeneration",
        "buildDigest",
        "qualificationDigest",
        "materialDigest",
        "roomBindingProofDigest",
        "version",
        "transportKind",
        "principalUid",
        "platformRoomId",
        "roomId",
        "liveEpochStartedAtMs"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "senderProcessNonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
